# ====================================================================
# Configuración del Backend - Mascotas Care API
# ====================================================================

PORT=3000
DATABASE_URL=postgresql://ampi@localhost:5432/mascotas_db
JWT_SECRET=super-secret-pet-care-jwt-key-2026
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ====================================================================
# Configuración del Servidor de Correo (SMTP / Nodemailer)
#
# Si dejas estas variables vacías o comentadas, el sistema operará en
# "Modo Simulado / Desarrollo" (imprime el código y enlace en consola
# y en la pantalla de la app para pruebas rápidas).
# ====================================================================

# --------------------------------------------------------------------
# OPCIÓN A: Usando Gmail (Recomendado y rápido)
# NOTA: Debes usar una "Contraseña de aplicación" de Google (App Password),
# NO tu contraseña personal normal.
# Generar en: https://myaccount.google.com/apppasswords
# --------------------------------------------------------------------
# SMTP_SERVICE=gmail
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM="Mascotas Care" <tu_cuenta@gmail.com>

# --------------------------------------------------------------------
# OPCIÓN B: Servidor SMTP Estándar (Brevo / Sendinblue, Mailgun, SendGrid)
# --------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_usuario_smtp
# SMTP_PASS=tu_clave_smtp
# SMTP_FROM="Mascotas Care" <no-reply@tudominio.com>

# --------------------------------------------------------------------
# OPCIÓN C: Outlook / Hotmail / Office365
# --------------------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_cuenta@outlook.com
# SMTP_PASS=tu_contraseña
# SMTP_FROM="Mascotas Care" <tu_cuenta@outlook.com>
